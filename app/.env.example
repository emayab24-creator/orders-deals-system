
# Google Sheets Integration (Optional)
# Получите эти значения после настройки Google Sheets API
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project"}

# OpenAI API Key (для обработки товаров)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Abacus AI API Key (для альтернативного AI)
ABACUSAI_API_KEY=your-abacus-ai-key-here
